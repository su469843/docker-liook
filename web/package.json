{
  "name": "course-hub-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postinstall": "node -e \"const fs=require('fs');fs.mkdirSync('public/ffmpeg',{recursive:true});for(const f of ['ffmpeg-core.js','ffmpeg-core.wasm'])fs.copyFileSync('node_modules/@ffmpeg/core/dist/'+f,'public/ffmpeg/'+f)\""
  },
  "dependencies": {
    "@ffmpeg/core": "0.11.0",
    "@ffmpeg/ffmpeg": "0.11.6",
    "hls.js": "^1.5.13",
    "vue": "^3.4.27",
    "vue-router": "^4.3.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "vite": "^5.2.11"
  }
}
