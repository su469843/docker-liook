[Unit]
Description=CourseHub 课程平台
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 专用系统账号：useradd -r -s /usr/sbin/nologin -d /opt/coursehub coursehub
User=coursehub
Group=coursehub
WorkingDirectory=/opt/coursehub
# 配置写在这里（参考 deploy/coursehub.env.example）
EnvironmentFile=-/etc/coursehub.env
# 数据库、视频、聊天图片都放这个目录
Environment=STORAGE_LOCAL_DIR=/var/lib/coursehub
ExecStart=/opt/coursehub/course-hub
Restart=on-failure
RestartSec=3

# 收到 SIGTERM 后程序会优雅关闭（等待进行中的请求，关闭 SQLite）
KillSignal=SIGTERM
TimeoutStopSec=20

# 安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/coursehub
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
