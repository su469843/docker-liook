# CourseHub 环境变量（systemd 部署时放到 /etc/coursehub.env，权限建议 600）
# 只写需要的项，其余用默认值。注意：这个文件用 systemd EnvironmentFile 解析，不要加引号和空格。

PORT=8080

# 站点名称（首次初始化写入数据库，之后在「后台管理 → 注册设置」里改）
SITE_NAME=课程中心

# 首次启动创建 admin 账号时的密码（务必修改！）
ADMIN_PASSWORD=请改成强密码

# 注意：写成 你的密钥 这样即可，不要带空格
# JWT_SECRET=换成32位以上随机串
JWT_SECRET=

# 注册模式（首次初始化写入数据库，之后以后台设置为准）
#   open=开放注册 | invite=必须填机构邀请码 | closed=关闭注册
REGISTER_MODE=open
# 机构邀请码（REGISTER_MODE=invite 时生效，留空自动生成）
ORG_INVITE_CODE=
# 兼容旧配置：REGISTER_MODE 未设置时，true=open、false=closed
ALLOW_REGISTER=true
COOKIE_SECURE=false

STORAGE_TYPE=local
STORAGE_LOCAL_DIR=/var/lib/coursehub

# S3 / MinIO（STORAGE_TYPE=s3 时生效）
# S3_ENDPOINT=127.0.0.1:9000
# S3_BUCKET=coursehub
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_USE_SSL=false

# WebDAV（STORAGE_TYPE=webdav 时生效）
# WEBDAV_URL=https://dav.example.com/coursehub
# WEBDAV_USERNAME=user
# WEBDAV_PASSWORD=pass

# TURN 服务器（公网音视频通话建议配置）
# TURN_URL=turn:example.com:3478
# TURN_USER=user
# TURN_PASS=pass

# ===== 视频转码 / 播放（服务端 HLS + AES-128 + 有效期签名地址） =====
# ffmpeg 可执行文件路径（Docker 镜像已内置 /usr/bin/ffmpeg；没装时自动退化为 MP4 + Range 渐进播放）
FFMPEG_PATH=ffmpeg
# 单个视频上传上限（MB），超过请改用分片上传
MAX_UPLOAD_MB=4096
# 播放/下载签名地址有效期（分钟），过期后需刷新页面重新签发
SIGN_TTL_MINUTES=120
# 同时转码的任务数（吃 CPU，按机器核数调）
TRANSCODE_CONCURRENCY=2
# TURN 共享密钥（coturn 的 use-auth-secret，推荐）：配了之后每次下发的 TURN 账号都是 2 小时临时账号
# 不配则回退到上面的 TURN_USER / TURN_PASS 固定账号
TURN_SECRET=
# 排障开关：前端白屏时可设 true 临时关闭 CSP（默认不关闭）
CSP_DISABLE=false