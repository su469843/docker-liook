# ===== 基础配置 =====
# 容器内监听端口（一般不用改）
PORT=8080
# docker compose 映射到宿主机的端口（想用 80 端口就改成 80）
HOST_PORT=8080
# 使用的镜像名。在服务器上直接构建时留空即可；
# 从镜像仓库拉取时填：IMAGE=ghcr.io/你的用户名/course-hub:latest
# 生产环境建议固定到具体版本（每次构建都会生成）：IMAGE=ghcr.io/你的用户名/course-hub:1.0.0-sha-6f179c0
IMAGE=
# 构建时注入的版本号（可选，只影响 docker compose build）；留空自动从 web/package.json + git 生成
# VERSION=
# 首次启动创建 admin 账号时的初始密码（务必修改！）
ADMIN_PASSWORD=admin123
# 会话签名密钥，随便一串随机字符（32 位以上）；
# 留空会自动生成并保存到数据目录 .jwt_secret，重启后不会掉登录（多实例部署必须显式指定同一个值）
JWT_SECRET=

# ===== 站点 =====
# 站点名称（显示在浏览器标题、登录页、顶部导航）
SITE_NAME=课程中心

# ===== 账号 =====
# 注册模式（推荐在后台“注册设置”里改，那里的设置优先；这里只影响首次初始化）
#   open   所有人都能自助注册
#   invite 必须填写机构邀请码才能注册（邀请码可在后台查看/重新生成）
#   closed 关闭注册，账号只能由管理员在后台创建
REGISTER_MODE=open
# 机构邀请码（REGISTER_MODE=invite 时使用；留空会自动生成，之后以后台设置为准）
ORG_INVITE_CODE=
# 兼容旧配置：REGISTER_MODE 未设置时，true 等价 open，false 等价 closed
ALLOW_REGISTER=true
# 全站 HTTPS 部署时设为 true，会话 Cookie 只在 HTTPS 下发送
COOKIE_SECURE=false

# ===== 存储后端 =====
# 可选：local（本地目录）| s3（MinIO/AWS 等 S3 兼容）| webdav
STORAGE_TYPE=local
# STORAGE_TYPE=local 时的存储目录（Docker 内固定 /data，用 systemd 部署时换成 /var/lib/coursehub）
STORAGE_LOCAL_DIR=./data

# ===== S3 / MinIO（STORAGE_TYPE=s3 时填写）=====
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=false

# ===== WebDAV（STORAGE_TYPE=webdav 时填写）=====
WEBDAV_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=

# ===== 音视频通话（可选）=====
# 公网部署时建议配置 TURN（如 coturn），否则部分网络下 WebRTC 无法互通
# 多个地址用英文逗号分隔，例如：turn:turn.example.com:3478
TURN_URL=
TURN_USER=
TURN_PASS=

# ===== 视频转码 / 播放（服务端 HLS + AES-128 + 有效期签名地址） =====
# ffmpeg 可执行文件路径（Docker 镜像已内置 /usr/bin/ffmpeg；没装时自动退化为 MP4 + Range 渐进播放）
FFMPEG_PATH=ffmpeg
# 单个视频上传上限（MB），超过请改用分片上传
MAX_UPLOAD_MB=4096
# 播放/下载签名地址有效期（分钟），过期后需刷新页面重新签发
SIGN_TTL_MINUTES=120
# 同时转码的任务数（吃 CPU，按机器核数调）
TRANSCODE_CONCURRENCY=2
# TURN 共享密钥（coturn 的 use-auth-secret，推荐）：配了之后每次下发的 TURN 账号都是 2 小时临时账号
# 不配则回退到上面的 TURN_USER / TURN_PASS 固定账号
TURN_SECRET=
# 排障开关：前端白屏时可设 true 临时关闭 CSP（默认不关闭）
CSP_DISABLE=false

# ===== 朗读 TTS（可选，单词/句子练习页的 🔊 按钮）=====
# 配置后前端朗读走本服务的 /api/tts 代理：API key 只存在服务端、不进前端产物，
# 音频带登录态鉴权 + 每用户限流 + 服务端内存缓存（同一单词全站只向上游合成一次）。
# 不配置时前端回退到 Worker 直连（web/.env 的 VITE_TTS_*）或浏览器内置发音。
# 填 OpenAI 兼容端点（如 linshenkx/edge-tts-openai-cf-worker 部署的地址）
TTS_URL=
TTS_KEY=
# 音色（Edge 音色名）与语速 0.5-2.0
TTS_VOICE=en-US-AriaNeural
TTS_SPEED=0.9