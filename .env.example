# ===== 基础配置 =====
# 容器内监听端口（一般不用改）
PORT=8080
# docker compose 映射到宿主机的端口（想用 80 端口就改成 80）
HOST_PORT=8080
# 使用的镜像名。在服务器上直接构建时留空即可；
# 从镜像仓库拉取时填：IMAGE=ghcr.io/你的用户名/course-hub:latest
IMAGE=
# 首次启动创建 admin 账号时的初始密码（务必修改！）
ADMIN_PASSWORD=admin123
# 会话签名密钥，随便一串随机字符（32 位以上）；
# 留空会自动生成并保存到数据目录 .jwt_secret，重启后不会掉登录（多实例部署必须显式指定同一个值）
JWT_SECRET=

# ===== 站点 =====
# 站点名称（显示在浏览器标题、登录页、顶部导航）
SITE_NAME=课程中心

# ===== 账号 =====
# 注册模式（推荐在后台“注册设置”里改，那里的设置优先；这里只影响首次初始化）
#   open   所有人都能自助注册
#   invite 必须填写机构邀请码才能注册（邀请码可在后台查看/重新生成）
#   closed 关闭注册，账号只能由管理员在后台创建
REGISTER_MODE=open
# 机构邀请码（REGISTER_MODE=invite 时使用；留空会自动生成，之后以后台设置为准）
ORG_INVITE_CODE=
# 兼容旧配置：REGISTER_MODE 未设置时，true 等价 open，false 等价 closed
ALLOW_REGISTER=true
# 全站 HTTPS 部署时设为 true，会话 Cookie 只在 HTTPS 下发送
COOKIE_SECURE=false

# ===== 存储后端 =====
# 可选：local（本地目录）| s3（MinIO/AWS 等 S3 兼容）| webdav
STORAGE_TYPE=local
# STORAGE_TYPE=local 时的存储目录（Docker 内固定 /data，用 systemd 部署时换成 /var/lib/coursehub）
STORAGE_LOCAL_DIR=./data

# ===== S3 / MinIO（STORAGE_TYPE=s3 时填写）=====
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=false

# ===== WebDAV（STORAGE_TYPE=webdav 时填写）=====
WEBDAV_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=

# ===== 音视频通话（可选）=====
# 公网部署时建议配置 TURN（如 coturn），否则部分网络下 WebRTC 无法互通
# 多个地址用英文逗号分隔，例如：turn:turn.example.com:3478
TURN_URL=
TURN_USER=
TURN_PASS=
